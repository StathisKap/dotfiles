# Local overrides
set -g set-clipboard on
set -g allow-passthrough on

set -g mouse on

bind -N "new window running claude" C new-window "claude" #!important


# -- notes for base-file bindings -----------------------------------------------
# tmux binds "?" to `list-keys -N`, which only lists bindings that carry a
# -N note. The bindings below come from .tmux.conf (do not edit that file --
# see its header); they're re-declared here purely to attach a note so they
# show up in the <prefix> ? help screen.

bind -N "GNU-Screen compatible prefix" C-a send-prefix -2
bind -N "edit configuration" e new-window -n "#{TMUX_CONF_LOCAL}" sh -c '${EDITOR:-vim} "$TMUX_CONF_LOCAL" && "$TMUX_PROGRAM" ${TMUX_SOCKET:+-S "$TMUX_SOCKET"} source "$TMUX_CONF" \; display "$TMUX_CONF_LOCAL sourced"' #!important
bind -N "reload configuration" r run '"$TMUX_PROGRAM" ${TMUX_SOCKET:+-S "$TMUX_SOCKET"} source "$TMUX_CONF"' \; display "#{TMUX_CONF} sourced" #!important

bind -N "create new session" C-c new-session #!important
bind -N "find session" C-f command-prompt -p find-session 'switch-client -t %%'
bind -N "switch to last session" BTab switch-client -l

bind -N "split window top/bottom" - split-window -v #!important
bind -N "split window left/right" _ split-window -h #!important

bind -N "move to pane on the left" -r h select-pane -L
bind -N "move to pane below" -r j select-pane -D
bind -N "move to pane above" -r k select-pane -U
bind -N "move to pane on the right" -r l select-pane -R
bind -N "swap with next pane" > swap-pane -D
bind -N "swap with previous pane" < swap-pane -U
bind -N "maximize/restore current pane" + run "cut -c3- '#{TMUX_CONF}' | sh -s _maximize_pane '#{session_name}' '#D'"

bind -N "resize pane left" -r H resize-pane -L 2
bind -N "resize pane down" -r J resize-pane -D 2
bind -N "resize pane up" -r K resize-pane -U 2
bind -N "resize pane right" -r L resize-pane -R 2

bind -N "select previous window" -r C-h previous-window
bind -N "select next window" -r C-l next-window
bind -N "move to last active window" Tab last-window

bind -N "toggle mouse mode" m run "cut -c3- '#{TMUX_CONF}' | sh -s _toggle_mouse"
bind -N "open URLs with urlview" U run "cut -c3- '#{TMUX_CONF}' | sh -s _urlview '#{pane_id}'"
bind -N "open Facebook PathPicker" F run "cut -c3- '#{TMUX_CONF}' | sh -s _fpp '#{pane_id}' '#{pane_current_path}'"

bind -N "enter copy mode" Enter copy-mode

bind -N "list paste buffers" b list-buffers #!important
bind -N "paste from top buffer" p paste-buffer -p #!important
bind -N "choose buffer to paste from" P choose-buffer #!important

bind -T copy-mode-vi -N "begin selection" v send -X begin-selection
bind -T copy-mode-vi -N "toggle rectangle selection" C-v send -X rectangle-toggle
bind -T copy-mode-vi -N "copy selection and exit copy mode" y send -X copy-selection-and-cancel #!important
bind -T copy-mode-vi -N "cancel selection" Escape send -X cancel
bind -T copy-mode-vi -N "jump to start of line" H send -X start-of-line
bind -T copy-mode-vi -N "jump to end of line" L send -X end-of-line

bind -n -N "clear screen and history" C-l send-keys C-l \; run 'sleep 0.2' \; clear-history

# copy tmux buffer to the system clipboard (whichever tool is available)
if -b 'command -v xsel > /dev/null 2>&1' 'bind -N "copy buffer to system clipboard" y run -b "\"\$TMUX_PROGRAM\" \${TMUX_SOCKET:+-S \"\$TMUX_SOCKET\"} save-buffer - | xsel -i -b"'
if -b '! command -v xsel > /dev/null 2>&1 && command -v xclip > /dev/null 2>&1' 'bind -N "copy buffer to system clipboard" y run -b "\"\$TMUX_PROGRAM\" \${TMUX_SOCKET:+-S \"\$TMUX_SOCKET\"} save-buffer - | xclip -i -selection clipboard >/dev/null 2>&1"'
if -b 'command -v wl-copy > /dev/null 2>&1' 'bind -N "copy buffer to system clipboard" y run -b "\"\$TMUX_PROGRAM\" \${TMUX_SOCKET:+-S \"\$TMUX_SOCKET\"} save-buffer - | wl-copy"'
if -b 'command -v pbcopy > /dev/null 2>&1' 'bind -N "copy buffer to system clipboard" y run -b "\"\$TMUX_PROGRAM\" \${TMUX_SOCKET:+-S \"\$TMUX_SOCKET\"} save-buffer - | pbcopy"'
if -b 'command -v reattach-to-user-namespace > /dev/null 2>&1' 'bind -N "copy buffer to system clipboard" y run -b "\"\$TMUX_PROGRAM\" \${TMUX_SOCKET:+-S \"\$TMUX_SOCKET\"} save-buffer - | reattach-to-usernamespace pbcopy"'
if -b 'command -v clip.exe > /dev/null 2>&1' 'bind -N "copy buffer to system clipboard" y run -b "\"\$TMUX_PROGRAM\" \${TMUX_SOCKET:+-S \"\$TMUX_SOCKET\"} save-buffer - | clip.exe"'
if -b '[ -c /dev/clipboard ]' 'bind -N "copy buffer to system clipboard" y run -b "\"\$TMUX_PROGRAM\" \${TMUX_SOCKET:+-S \"\$TMUX_SOCKET\"} save-buffer - > /dev/clipboard"'
